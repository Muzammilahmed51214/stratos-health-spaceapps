# StratosHealth Backend — Environment Configuration
# Copy this file to .env and insert your API keys.

# ─── Google Gemini API Key (Required for Live AI LLM Reasoning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional Configuration ────────────────────────────────────
DATABASE_URL=sqlite:///./stratos_health.db
PORT=8000
HOST=0.0.0.0
